# ============================================================================
# Stage 1: Builder - Build UCX and UCXX with perftest binaries
# ============================================================================
FROM nvidia/cuda:12.8.0-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    build-essential \
    autoconf \
    automake \
    git \
    libz-dev \
    libtool \
    libnuma-dev \
    libibverbs-dev \
    librdmacm-dev && \
    rm -rf /var/lib/apt/lists/*

# Install CMake (minimal installation for UCXX)
WORKDIR /usr/local/share
RUN wget -q https://github.com/Kitware/CMake/releases/download/v3.31.9/cmake-3.31.9-linux-x86_64.tar.gz && \
    tar -xzf cmake-3.31.9-linux-x86_64.tar.gz && \
    rm cmake-3.31.9-linux-x86_64.tar.gz && \
    ln -s /usr/local/share/cmake-3.31.9-linux-x86_64/bin/* /usr/local/bin/

# Build UCX from master branch
WORKDIR /workspace
RUN git clone --depth 1 https://github.com/openucx/ucx.git && \
    cd ucx && \
    ./autogen.sh && \
    ./configure --prefix=/usr/local \
                --enable-mt \
                --enable-optimizations \
                --enable-srd \
                --with-cuda=/usr/local/cuda \
                --without-go \
                --without-java \
                --disable-logging \
                --disable-debug \
                --disable-assertions \
                --disable-params-check && \
    make -j$(nproc) && \
    make install && \
    # Install ucx_perftest binary manually (not installed by default)
    # Copy the actual binary from .libs directory and install to /usr/local/bin
    cp src/tools/perf/.libs/ucx_perftest /usr/local/bin/ucx_perftest && \
    chmod +x /usr/local/bin/ucx_perftest && \
    ldconfig && \
    cd .. && \
    rm -rf ucx

# Build UCXX version 0.46.0 with benchmarks
WORKDIR /workspace
RUN git clone --depth 1 --branch branch-0.46 https://github.com/rapidsai/ucxx.git && \
    cd ucxx/cpp && \
    mkdir -p build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX="/usr/local" \
      -DBUILD_TESTS=OFF \
      -DBUILD_BENCHMARKS=ON \
      -DCMAKE_BUILD_TYPE=Release \
      -DUCXX_ENABLE_PYTHON=OFF \
      -DUCXX_ENABLE_RMM=ON \
      -DUCXX_BENCHMARKS_ENABLE_CUDA=ON && \
    make -j$(nproc) && \
    make install && \
    # Install ucxx_perftest binary manually (benchmarks are not installed by default)
    cp benchmarks/ucxx_perftest /usr/local/bin/ucxx_perftest && \
    chmod +x /usr/local/bin/ucxx_perftest && \
    cd /workspace && \
    rm -rf ucxx

# Prepare RDMA libraries for runtime (copy only what exists)
RUN mkdir -p /opt/rdma-libs && \
    cp -r /etc/libibverbs.d /opt/rdma-libs/ 2>/dev/null || true && \
    cp -r /usr/lib/x86_64-linux-gnu/libibverbs /opt/rdma-libs/ 2>/dev/null || true && \
    find /usr/lib/x86_64-linux-gnu -name "lib*verbs*.so*" -exec cp {} /opt/rdma-libs/ \; 2>/dev/null || true && \
    find /usr/lib/x86_64-linux-gnu -name "libmlx*.so*" -exec cp {} /opt/rdma-libs/ \; 2>/dev/null || true && \
    find /usr/lib/x86_64-linux-gnu -name "libefa*.so*" -exec cp {} /opt/rdma-libs/ \; 2>/dev/null || true && \
    find /usr/lib/x86_64-linux-gnu -name "libmana*.so*" -exec cp {} /opt/rdma-libs/ \; 2>/dev/null || true

# ============================================================================
# Stage 2: Runtime - Minimal runtime image with UCX, UCXX, and perftest binaries
# ============================================================================
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install only essential runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libnuma1 \
    libibverbs1 \
    librdmacm1 \
    zlib1g \
    libgomp1 \
    libstdc++6 && \
    rm -rf /var/lib/apt/lists/*

# Copy UCX and UCXX libraries and binaries
COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy pre-staged RDMA libraries and restore them to proper locations
COPY --from=builder /opt/rdma-libs /opt/rdma-libs
RUN if [ -d /opt/rdma-libs/libibverbs.d ]; then \
        mkdir -p /etc && cp -r /opt/rdma-libs/libibverbs.d /etc/; \
    fi && \
    if [ -d /opt/rdma-libs/libibverbs ]; then \
        mkdir -p /usr/lib/x86_64-linux-gnu && cp -r /opt/rdma-libs/libibverbs /usr/lib/x86_64-linux-gnu/; \
    fi && \
    find /opt/rdma-libs -name "*.so*" -exec cp {} /usr/lib/x86_64-linux-gnu/ \; 2>/dev/null || true && \
    rm -rf /opt/rdma-libs

# Update library cache
RUN ldconfig

WORKDIR /workspace

# Default to running bash (users can run ucx_perftest or ucxx_perftest)
CMD ["/bin/bash"]
